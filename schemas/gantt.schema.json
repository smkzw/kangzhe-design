{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "min",
    "max",
    "tasks"
  ],
  "properties": {
    "min": {
      "type": "integer"
    },
    "max": {
      "type": "integer"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": [
              "integer",
              "null"
            ],
            "description": "季度 index；start_known=false 时可为 null"
          },
          "end": {
            "type": [
              "integer",
              "null"
            ],
            "description": "[start,end) 的 end；end_known=false 时可为 null"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "owner": {
            "type": "string"
          },
          "department": {
            "enum": [
              "medical",
              "operations",
              "statistics",
              "pv"
            ],
            "description": "表达部门身份时取部门色"
          },
          "status": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "start_known": {
            "type": "boolean",
            "description": "false 时界面须标示待定，不编造起点"
          },
          "end_known": {
            "type": "boolean",
            "description": "false 时界面须标示待定，不编造时长"
          },
          "row": {
            "type": "string",
            "minLength": 1,
            "description": "泳道模式：所在行的 id；同一行的任务按时间先后排列、不重叠"
          },
          "phase": {
            "type": "string",
            "minLength": 1,
            "description": "泳道模式：阶段名（与图例一致），只作说明"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "not": {
                "properties": {
                  "start_known": {
                    "const": false
                  }
                },
                "required": [
                  "start_known"
                ]
              }
            },
            "then": {
              "properties": {
                "start": {
                  "type": "integer"
                }
              }
            }
          },
          {
            "if": {
              "not": {
                "properties": {
                  "end_known": {
                    "const": false
                  }
                },
                "required": [
                  "end_known"
                ]
              }
            },
            "then": {
              "properties": {
                "end": {
                  "type": "integer"
                }
              }
            }
          }
        ]
      }
    },
    "taskColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "泳道模式（8.0）：一行一条泳道，任务以 row 归行；不写 rows 时一任务一行",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "description": "行名下的小字，如研究编号"
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "description": "里程碑：绑定任务的 start/end 边（随任务一起编辑移动），或固定在某行的某季度（row+at）",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "start",
              "readout",
              "submit",
              "approve",
              "other"
            ]
          },
          "risk": {
            "type": "boolean"
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "edge": {
            "enum": [
              "start",
              "end"
            ]
          },
          "row": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "integer"
          }
        },
        "oneOf": [
          {
            "required": [
              "task",
              "edge"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "row"
                  ]
                },
                {
                  "required": [
                    "at"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "row",
              "at"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "task"
                  ]
                },
                {
                  "required": [
                    "edge"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "today": {
      "type": "integer",
      "description": "当前季度序号；画当前线，之后的部分按计划（浅色虚线）绘制"
    },
    "legend": {
      "type": "array",
      "description": "阶段图例（顶部一行）",
      "items": {
        "type": "object",
        "required": [
          "label",
          "color"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
