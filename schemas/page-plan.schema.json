{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kangzhe:page-plan:6.0",
  "type": "object",
  "required": [
    "schema_version",
    "track",
    "canvas",
    "pages",
    "contract_revision",
    "target_viewports"
  ],
  "properties": {
    "schema_version": {
      "const": "6.0"
    },
    "track": {
      "enum": [
        "pptx",
        "htmlppt",
        "site",
        "stream"
      ]
    },
    "canvas": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "body_profile",
          "elements",
          "protected_regions",
          "image",
          "sources",
          "cards"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "cover",
              "toc",
              "section",
              "body",
              "ending",
              "hero",
              "flow_section"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body_profile": {
            "enum": [
              "standard",
              "compact"
            ]
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "role",
                "font_px",
                "line_height"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "page_title",
                    "card_title",
                    "body",
                    "chart_label",
                    "takeaway",
                    "footer",
                    "reference",
                    "cover_title",
                    "hero_subtitle",
                    "hero_meta",
                    "toc_title",
                    "toc_number",
                    "toc_label",
                    "toc_description",
                    "section_number",
                    "section_title",
                    "ending_title"
                  ]
                },
                "font_px": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "line_height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "text": {
                  "type": "string"
                },
                "rect": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "additionalProperties": false
            }
          },
          "protected_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "rect",
                "role"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "rect": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                },
                "role": {
                  "enum": [
                    "title",
                    "logo",
                    "header",
                    "footer",
                    "body",
                    "takeaway",
                    "control",
                    "data",
                    "other"
                  ]
                },
                "motion_margin": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "image": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "generated",
                  "global_procedural_optical_field"
                ]
              },
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "subject_rects": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "procedural_evidence": {
                "type": "string"
              },
              "viewport_assets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "viewport",
                    "asset_id"
                  ],
                  "properties": {
                    "viewport": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "asset_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "viewport_regions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "viewport",
                    "protected_regions"
                  ],
                  "properties": {
                    "viewport": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "protected_regions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "rect",
                          "role"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "rect": {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "number"
                              }
                            ],
                            "items": false,
                            "minItems": 4,
                            "maxItems": 4
                          },
                          "role": {
                            "enum": [
                              "title",
                              "logo",
                              "header",
                              "footer",
                              "body",
                              "takeaway",
                              "control",
                              "data",
                              "other"
                            ]
                          },
                          "motion_margin": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "generated"
                    }
                  }
                },
                "then": {
                  "required": [
                    "asset_id"
                  ]
                }
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "visible"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "scientific_paper",
                    "guideline",
                    "consensus",
                    "guidance",
                    "internal",
                    "news",
                    "registry",
                    "other"
                  ]
                },
                "visible": {
                  "type": "boolean"
                },
                "locator": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "material",
                "edge_decoration",
                "layout_mode"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "material": {
                  "enum": [
                    "liquid_glass",
                    "accessible_glass"
                  ]
                },
                "edge_decoration": {
                  "enum": [
                    "none",
                    "neutral_hairline",
                    "localized_highlight"
                  ]
                },
                "layout_mode": {
                  "enum": [
                    "stack",
                    "distributed",
                    "centered",
                    "compact"
                  ]
                },
                "layout_reason": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "takeaway": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "font_px": {
                "type": "number"
              },
              "align": {
                "const": "center"
              },
              "rationale": {
                "type": "string"
              }
            },
            "required": [
              "text",
              "font_px",
              "align",
              "rationale"
            ],
            "additionalProperties": false
          },
          "hero_layout_id": {
            "enum": [
              "cover-01",
              "toc-01",
              "section-01",
              "ending-01"
            ]
          },
          "motion_objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "role",
                "enter",
                "exit",
                "hover",
                "ambient"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "enter": {
                  "type": "string"
                },
                "exit": {
                  "type": "string"
                },
                "hover": {
                  "type": "string"
                },
                "ambient": {
                  "type": "string"
                },
                "data_progress": {
                  "type": "string"
                },
                "film_id": {
                  "type": "string"
                },
                "static_reason": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "contract_revision": {
      "const": "A04"
    },
    "target_viewports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "track": {
            "enum": [
              "pptx",
              "htmlppt"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pages": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "cover"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "hero_layout_id"
                    ],
                    "properties": {
                      "hero_layout_id": {
                        "const": "cover-01"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "toc"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "hero_layout_id"
                    ],
                    "properties": {
                      "hero_layout_id": {
                        "const": "toc-01"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "section"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "hero_layout_id"
                    ],
                    "properties": {
                      "hero_layout_id": {
                        "const": "section-01"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "ending"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "hero_layout_id"
                    ],
                    "properties": {
                      "hero_layout_id": {
                        "const": "ending-01"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "enum": [
              "htmlppt",
              "site",
              "stream"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pages": {
            "items": {
              "required": [
                "motion_objects"
              ],
              "properties": {
                "motion_objects": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
