                      "hero_layout_id"
                    ],
                    "properties": {
                      "hero_layout_id": {
                        "const": "flagship-ending"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "enum": [
              "htmlppt",
              "site",
              "stream"
            ]
